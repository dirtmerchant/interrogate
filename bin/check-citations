#!/usr/bin/env bash
# Check that every path:line citation in the interrogate notes resolves.
#
# A finding written by a model is not evidence. The cited code is the
# evidence, and the finding points to it. This script checks only the
# pointer: that the cited file exists at the assessed commit and that the
# cited lines are within it. Whether the cited lines support the claim is a
# judgment for a human reviewer, and nothing here attempts it.
#
# Needs bash 3.2+, git (for git targets), and jq.
set -euo pipefail

SELF="check-citations"
PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$PLUGIN_ROOT/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: check-citations [options] [target-dir] [notes-file ...]

Extracts every path:line and path:line-line citation from the notes files,
resolves each one, and writes a per-citation pass/fail report. Exits 0 when
every citation resolves, 1 when any fails, 2 on a usage error.

Citations resolve against the commit recorded in .interrogate/run.json, or
HEAD if there is no run.json. For a target that is not a git repository they
resolve against the working tree.

With no notes files given, checks every .interrogate/*.md.

Options:
  --commit SHA      Resolve against this commit instead.
  --worktree        Resolve against the working tree, even in a git repository.
  --dir DIR         Notes directory, relative to target-dir (default .interrogate).
  --include FILE    Also check FILE (repeatable), e.g. ARCHITECTURE.md.
  --out FILE        Where to write the report (default .interrogate/citations.json,
                    relative to target-dir). Use - for stdout.
  -q, --quiet       Print only the summary line and failures.
  -h, --help        Show this help.

Citations of the measurements, <dir>/metrics/<file>.tsv:<row>, resolve
against those files, where row 1 is the header line.

Notes files that contain a findings index (a "<!-- findings-index: KIND -->"
line followed by a table) are also checked: the table must have the expected
header and valid values. 02-patterns.md and 05-hotspots.md must have one.

A pass means the file and lines exist. It does not mean they support the
claim made about them.
EOF
}

COMMIT=""
WORKTREE=0
DIR=".interrogate"
OUT=""
QUIET=0
TARGET=""
NOTES=()
INCLUDES=()

while [ $# -gt 0 ]; do
  case "$1" in
    --commit)   COMMIT="${2:?--commit needs a value}"; shift 2 ;;
    --worktree) WORKTREE=1; shift ;;
    --dir)      DIR="${2:?--dir needs a value}"; DIR="${DIR%/}"; shift 2 ;;
    --include)  INCLUDES+=("${2:?--include needs a value}"); shift 2 ;;
    --out)      OUT="${2:?--out needs a value}"; shift 2 ;;
    -q|--quiet) QUIET=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    -*)         echo "$SELF: unknown option $1" >&2; usage >&2; exit 2 ;;
    *)          if [ -z "$TARGET" ]; then TARGET="$1"; else NOTES+=("$1"); fi; shift ;;
  esac
done

need_jq "$SELF"
TARGET="${TARGET:-.}"
[ -d "$TARGET" ] || { echo "$SELF: $TARGET is not a directory" >&2; exit 2; }
cd "$TARGET"
OUT="${OUT:-$DIR/citations.json}"

IN_GIT=0
PREFIX=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  IN_GIT=1
  PREFIX="$(git rev-parse --show-prefix)"
fi

# Decide what to resolve against.
MODE="worktree"
if [ "$WORKTREE" -eq 0 ] && [ "$IN_GIT" -eq 1 ]; then
  if [ -z "$COMMIT" ] && [ -f "$DIR/run.json" ]; then
    COMMIT="$(jq -r '.target.commit // empty' "$DIR/run.json" 2>/dev/null || true)"
  fi
  if [ -z "$COMMIT" ]; then
    COMMIT="$(git rev-parse HEAD 2>/dev/null || true)"
  fi
  if [ -n "$COMMIT" ]; then
    COMMIT="$(git rev-parse --verify -q "$COMMIT^{commit}" || true)"
    [ -n "$COMMIT" ] || { echo "$SELF: commit not found in this repository" >&2; exit 2; }
    MODE="commit"
  fi
fi

# Default notes set: every Markdown file the steps write in the notes directory.
if [ ${#NOTES[@]} -eq 0 ]; then
  for f in "$DIR"/*.md; do
    [ -f "$f" ] && NOTES+=("$f")
  done
fi
if [ ${#INCLUDES[@]} -gt 0 ]; then
  for f in "${INCLUDES[@]}"; do
    [ -f "$f" ] && NOTES+=("$f")
  done
fi

W="$(mktemp -d "${TMPDIR:-/tmp}/check-citations.XXXXXX")"
trap 'rm -rf "$W"' EXIT
: > "$W/cites"
: > "$W/files"

# The citation pattern. A token of path characters, a colon, a line number,
# and optionally -endline. The character before the token must not be a path
# character, a colon, or a slash, which keeps URLs (https://host:443) out.
# A :column suffix after the line is allowed and ignored.
RE='(^|[^A-Za-z0-9_./:@+~-])([A-Za-z0-9_./@+-][A-Za-z0-9_./@+~-]*):([0-9]+)(-([0-9]+))?'

# Tokens that have neither a slash nor a dot are only treated as citations
# when they are a well-known extensionless file name. Anything else ("step:3",
# "10:30") is prose, not a citation.
is_bare_name() {
  case "$1" in
    Makefile|GNUmakefile|Dockerfile|Containerfile|Gemfile|Rakefile|Procfile|Jenkinsfile|Vagrantfile|Brewfile|Podfile|Justfile|justfile|Taskfile|BUILD|WORKSPACE|LICENSE|NOTICE|CODEOWNERS|OWNERS) return 0 ;;
  esac
  return 1
}

# Collapse . and .. so a cited path can be looked up. Prints ESCAPE if the
# path climbs above its root.
normalize() {
  printf '%s\n' "$1" | awk -F/ '{
    n = 0
    for (i = 1; i <= NF; i++) {
      if ($i == "" || $i == ".") continue
      if ($i == "..") { if (n == 0) { print "ESCAPE"; exit } n--; continue }
      a[++n] = $i
    }
    s = ""
    for (i = 1; i <= n; i++) s = s (i > 1 ? "/" : "") a[i]
    print s
  }'
}

total_files=0
if [ ${#NOTES[@]} -gt 0 ]; then
for nf in "${NOTES[@]}"; do
  total_files=$((total_files + 1))
  count=0
  # grep -o prints each match on its own line, prefixed by the line number.
  while IFS= read -r hit; do
    nline="${hit%%:*}"
    m="${hit#*:}"
    # Drop the one leading boundary character, if the match has one.
    case "$m" in
      [A-Za-z0-9_./@+-]*) ;;
      *) m="${m#?}" ;;
    esac
    path="${m%%:*}"
    rest="${m#*:}"
    start="${rest%%-*}"
    case "$rest" in *-*) end="${rest#*-}" ;; *) end="$start" ;; esac

    case "$path" in
      */*|*.*) ;;
      *) is_bare_name "$path" || continue ;;
    esac
    # Version numbers, IP addresses, and ratios such as 1.5:1 are not paths.
    case "$path" in *[!0-9.]*) ;; *) continue ;; esac
    # A trailing dot is sentence punctuation, e.g. "see db.py:4." is fine but
    # "e.g.:" never reaches here because it has no line number.

    pre=""
    case "$path" in
      /*) pre="fail:absolute path; citations must be relative to the target" ;;
    esac
    norm=""
    if [ -z "$pre" ]; then
      norm="$(normalize "$path")"
      case "$norm" in
        "$DIR"/metrics/*.tsv) pre="metric" ;;
        "$DIR"/*|.interrogate/*) pre="skip:cites the notes, not the code" ;;
        ESCAPE) pre="fail:path climbs above the target" ;;
      esac
    fi
    # Measurements live in the notes directory, not in the commit, so they
    # resolve against the working tree; --verify checks they are unchanged.
    if [ "$pre" = "metric" ]; then
      pre=""
    elif [ -z "$pre" ] && [ "$MODE" = "commit" ]; then
      norm="$(normalize "$PREFIX$path")"
      [ "$norm" = "ESCAPE" ] && pre="fail:path climbs above the repository root"
    fi
    count=$((count + 1))
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$nf" "$nline" "$m" "$norm" "$start" "$end" "$pre" >> "$W/cites"
  done < <(grep -noE "$RE" "$nf" || true)
  printf '%s\t%s\t%s\n' "$nf" "$(sha256_file "$nf")" "$count" >> "$W/files"
done
fi

# Resolve each distinct path once: kind (file, dir, missing) and line count.
: > "$W/resolved"
awk -F'\t' '$7 == "" { print $4 }' "$W/cites" | sort -u | while IFS= read -r p; do
  [ -n "$p" ] || continue
  case "$p" in
    "$DIR"/metrics/*.tsv)
      if [ -f "$p" ]; then printf '%s\tfile\t%s\n' "$p" "$(awk 'END { print NR }' "$p")"
      else printf '%s\tmissing\t0\n' "$p"; fi
      continue ;;
  esac
  if [ "$MODE" = "commit" ]; then
    kind="$(git cat-file -t "$COMMIT:$p" 2>/dev/null || true)"
    case "$kind" in
      blob) printf '%s\tfile\t%s\n' "$p" "$(git cat-file -p "$COMMIT:$p" | awk 'END { print NR }')" ;;
      tree) printf '%s\tdir\t0\n' "$p" ;;
      *)    printf '%s\tmissing\t0\n' "$p" ;;
    esac
  else
    if [ -f "$p" ]; then printf '%s\tfile\t%s\n' "$p" "$(awk 'END { print NR }' "$p")"
    elif [ -d "$p" ]; then printf '%s\tdir\t0\n' "$p"
    else printf '%s\tmissing\t0\n' "$p"
    fi
  fi
done > "$W/resolved"

if [ "$MODE" = "commit" ]; then where="commit ${COMMIT:0:12}"; else where="the working tree"; fi

# ---------------------------------------------------------------------------
# Findings indexes. A fixed-format table that lets runs be compared without
# a model. Kinds and their columns:
#   patterns: pattern | scope | status (Enforced or Aspirational) | violations
#   hotspots: rank | path | fanin | churn_window | measured (yes, no, partial)
# Output: one IDX line per index (ok or an error), one ROW line per row.
# ---------------------------------------------------------------------------
: > "$W/index"
if [ ${#NOTES[@]} -gt 0 ]; then
for nf in "${NOTES[@]}"; do
  awk -v nf="$nf" '
    function trim(x) { gsub(/^[ \t]+|[ \t]+$/, "", x); return x }
    function cells(line, out,   n, i, parts) {
      line = trim(line); sub(/^\|/, "", line); sub(/\|$/, "", line)
      n = split(line, parts, "|")
      for (i = 1; i <= n; i++) { out[i] = trim(parts[i]); gsub(/`/, "", out[i]) }
      return n
    }
    function fail(msg) { print "IDX\t" nf "\t" kind "\tfail\t" start "\t" msg; bad = 1 }
    function finish() {
      if (kind == "") return
      if (!bad && state < 3) fail("the table after the marker is missing or incomplete")
      if (!bad && rows == 0) fail("the table has no rows")
      if (!bad) print "IDX\t" nf "\t" kind "\tok\t" start "\t" rows " rows"
      found[kind] = 1; kind = ""
    }
    /<!--[ \t]*findings-index:/ {
      finish()
      kind = $0; sub(/.*findings-index:[ \t]*/, "", kind); sub(/[ \t]*-->.*/, "", kind)
      start = FNR; state = 0; rows = 0; bad = 0
      if (kind == "patterns") want = "pattern|scope|status|violations"
      else if (kind == "hotspots") want = "rank|path|fanin|churn_window|measured"
      else { fail("unknown index kind \"" kind "\" (expected patterns or hotspots)"); kind = "" }
      next
    }
    kind != "" && state == 0 && /^[ \t]*$/ { next }
    kind != "" && state == 0 {
      n = cells($0, c); h = ""
      for (i = 1; i <= n; i++) h = h (i > 1 ? "|" : "") tolower(c[i])
      if (h != want) { fail("header is \"" h "\", expected \"" want "\""); kind = ""; next }
      ncol = n; state = 1; next
    }
    kind != "" && state == 1 { if ($0 !~ /^[ \t]*\|[ \t:|-]+\|?[ \t]*$/) { fail("line " FNR ": expected the |---| separator row") ; kind = ""; next } state = 3; next }
    kind != "" && state == 3 && $0 !~ /^[ \t]*\|/ { finish(); next }
    kind != "" && state == 3 {
      n = cells($0, c)
      if (n != ncol) { fail("line " FNR ": " n " columns, expected " ncol); next }
      rows++
      if (kind == "patterns") {
        if (c[1] == "") fail("line " FNR ": pattern name is empty")
        if (c[3] != "Enforced" && c[3] != "Aspirational") fail("line " FNR ": status \"" c[3] "\" must be Enforced or Aspirational")
        if (c[4] !~ /^[0-9]+$/) fail("line " FNR ": violations \"" c[4] "\" must be a whole number")
      } else {
        if (c[1] != rows) fail("line " FNR ": rank \"" c[1] "\", expected " rows)
        if (c[2] == "") fail("line " FNR ": path is empty")
        if (c[3] !~ /^([0-9]+|-)$/) fail("line " FNR ": fanin \"" c[3] "\" must be a whole number or -")
        if (c[4] !~ /^([0-9]+|-)$/) fail("line " FNR ": churn_window \"" c[4] "\" must be a whole number or -")
        if (c[5] != "yes" && c[5] != "no" && c[5] != "partial") fail("line " FNR ": measured \"" c[5] "\" must be yes, no, or partial")
      }
      row = "ROW\t" nf "\t" kind
      for (i = 1; i <= n; i++) row = row "\t" c[i]
      print row
      next
    }
    END {
      finish()
      b = nf; sub(/.*\//, "", b)
      if (b == "02-patterns.md" && !("patterns" in found)) { kind = "patterns"; start = 0; print "IDX\t" nf "\tpatterns\tfail\t0\tno findings index: the patterns notes must end with <!-- findings-index: patterns --> and its table" }
      if (b == "05-hotspots.md" && !("hotspots" in found)) { print "IDX\t" nf "\thotspots\tfail\t0\tno findings index: the hotspots notes must end with <!-- findings-index: hotspots --> and its table" }
    }
  ' "$nf" >> "$W/index"
done
fi

# Join citations with their resolution and decide pass, fail, or skip.
awk -F'\t' -v OFS='\t' -v where="$where" '
  NR == FNR { kind[$1] = $2; lines[$1] = $3; next }
  {
    status = "pass"; reason = ""
    if ($7 != "") {
      split($7, pr, ":"); status = pr[1]; reason = substr($7, length(pr[1]) + 2)
    } else if (kind[$4] == "missing") {
      status = "fail"; reason = "file missing at " where
    } else if (kind[$4] == "dir") {
      status = "fail"; reason = "is a directory, not a file"
    } else if ($5 + 0 < 1) {
      status = "fail"; reason = "line numbers start at 1"
    } else if ($6 + 0 < $5 + 0) {
      status = "fail"; reason = "range is reversed"
    } else if ($6 + 0 > lines[$4] + 0) {
      status = "fail"; reason = "line " $6 " out of range (file has " lines[$4] " lines)"
    }
    print $1, $2, $3, $4, $5, $6, status, reason
  }' "$W/resolved" "$W/cites" > "$W/results"

report="$(
  jq -n \
    --rawfile results "$W/results" \
    --rawfile files "$W/files" \
    --rawfile index "$W/index" \
    --arg mode "$MODE" --arg commit "$COMMIT" --arg prefix "$PREFIX" \
    --arg at "$(now_utc)" '
    def rows($s): $s | split("\n") | map(select(length > 0) | split("\t"));
    (rows($results) | map({
        notes_file: .[0], notes_line: (.[1] | tonumber), citation: .[2],
        path: (if .[3] == "" then null else .[3] end),
        start: (.[4] | tonumber), end: (.[5] | tonumber),
        status: .[6], reason: (if .[7] == "" then null else .[7] end)
      })) as $c
    | {
        schema_version: 1,
        generated_by: "bin/check-citations",
        generated_at: $at,
        resolved_against: (if $mode == "commit"
          then {kind: "git-commit", commit: $commit, repo_prefix: $prefix}
          else {kind: "working-tree"} end),
        meaning: "pass means the cited file exists and the cited lines are within it. It does not mean the lines support the claim; that needs a human reviewer.",
        summary: {
          citations: ($c | length),
          passed: ($c | map(select(.status == "pass")) | length),
          failed: ($c | map(select(.status == "fail")) | length),
          skipped: ($c | map(select(.status == "skip")) | length)
        },
        files: (rows($files) | map({path: .[0], sha256: .[1], citations: (.[2] | tonumber)})),
        citations: $c,
        indexes: (rows($index) as $r
          | ($r | map(select(.[0] == "IDX")) | group_by(.[1] + "\u0000" + .[2])
             | map({notes_file: .[0][1], kind: .[0][2], line: (.[0][4] | tonumber),
                    status: (if any(.[]; .[3] == "fail") then "fail" else "pass" end),
                    errors: map(select(.[3] == "fail") | .[5])}))
          | map(. as $i | . + {rows: ($r | map(select(.[0] == "ROW" and .[1] == $i.notes_file and .[2] == $i.kind) | .[3:])
              | map(if $i.kind == "patterns"
                    then {pattern: .[0], scope: .[1], status: .[2], violations: (.[3] | tonumber? // .[3])}
                    else {rank: (.[0] | tonumber? // .[0]), path: .[1], fanin: .[2], churn_window: .[3], measured: .[4]} end))}))
      }
      | .summary.index_failures = (.indexes | map(select(.status == "fail")) | length)'
)"

if [ "$OUT" = "-" ]; then
  printf '%s\n' "$report"
else
  mkdir -p "$(dirname "$OUT")"
  printf '%s\n' "$report" | write_atomic "$OUT"
fi

failed="$(printf '%s' "$report" | jq '.summary.failed + .summary.index_failures')"
# The human summary goes to stderr when the report itself goes to stdout.
if [ "$OUT" = "-" ]; then exec 3>&2; else exec 3>&1; fi
{
printf '%s' "$report" | jq -r --arg where "$where" '
  "citations: \(.summary.citations) found in \(.files | length) file(s), \(.summary.passed) passed, \(.summary.failed) failed, \(.summary.skipped) skipped (resolved against \($where))"'
printf '%s' "$report" | jq -r '.citations[] | select(.status == "fail") | "  FAIL \(.notes_file):\(.notes_line)  \(.citation)  \(.reason)"'
printf '%s' "$report" | jq -r '.indexes[] | if .status == "fail" then (.errors[] as $e | "  FAIL \(.notes_file):\(.line)  findings index (\(.kind))  \($e)") else "  findings index (\(.kind)) in \(.notes_file): \(.rows | length) rows, valid" end'
if [ "$QUIET" -eq 0 ]; then
  printf '%s' "$report" | jq -r '.files[] | select(.citations == 0) | "  note: no citations found in \(.path)"'
fi
} >&3

[ "$failed" -eq 0 ] || exit 1
exit 0
